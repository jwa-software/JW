# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "A layered Rocq library of data structures, algebra, relations and tactics"
description:
  "JW is a general-purpose Rocq library organised in layers, each a separate theory under the logical root JW: Dialect, Core, Tactics, Algebra, Relation, Data and Assumption. Clients import a layer with From JW Require Import <Layer>.All, or everything but the axiom layer with From JW Require Import All."
maintainer: ["Junzhe Wang <research@junzhewang.de>"]
authors: ["Junzhe Wang"]
license: "MIT"
tags: ["rocq" "logpath:JW"]
homepage: "https://github.com/jwa-software/JW"
bug-reports: "https://github.com/jwa-software/JW/issues"
depends: [
  "dune" {>= "3.21"}
  "rocq-core" {>= "9.3" & < "9.4"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jwa-software/JW.git"
x-maintenance-intent: ["(latest)"]
