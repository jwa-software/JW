; Extract.v writes JW.ml and JW.mli; dune has to know the module names
; before it runs the extraction, so they are listed here.

(rocq.extraction
 (prelude Extract)
 (extracted_modules JW)
 (theories
  Ltac2
  JW
  JW.Dialect
  JW.Core
  JW.Tactics
  JW.Algebra
  JW.Relation
  JW.Data))

; The extracted code is generated: an unused variable or an unused match case
; in it says nothing about the library, so its warnings are off.

(library
 (name jw_extraction)
 (modules JW)
 (wrapped false)
 (flags
  (:standard -w -a)))

; make build compiles the test; make test runs it.

(test
 (name extraction_test)
 (modules extraction_test)
 (libraries jw_extraction))
